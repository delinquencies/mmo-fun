class_name UISkin
## Shared look for the tactile UI: leather panels, parchment tooltips, timber
## title bars, slot frames. Art is generated by tools/forge/ui_art.py.

const TEXT := Color(0.93, 0.87, 0.72)
const TEXT_DIM := Color(0.68, 0.6, 0.46)
const GOLD := Color(0.98, 0.82, 0.42)
const INK := Color(0.2, 0.12, 0.06)
const INK_DIM := Color(0.38, 0.26, 0.14)
const BAD := Color(1.0, 0.45, 0.32)
const FONT_SIZE := 13

static var _cache: Dictionary = {}


static func tex(path: String) -> Texture2D:
	if _cache.has(path):
		return _cache[path]
	var t: Texture2D
	var abs_path := ProjectSettings.globalize_path(path)
	if FileAccess.file_exists(abs_path):
		var img := Image.load_from_file(abs_path)
		if img:
			t = ImageTexture.create_from_image(img)
	if t == null and ResourceLoader.exists(path):
		t = load(path)
	_cache[path] = t
	return t


static func ui(name: String) -> Texture2D:
	return tex("res://assets/ui/%s.png" % name)


static func icon(icon_id: String) -> Texture2D:
	return tex("res://assets/generated/ui/icons/%s.png" % icon_id)


static func _box(name: String, margin: int, content: int) -> StyleBoxTexture:
	var sb := StyleBoxTexture.new()
	sb.texture = ui(name)
	sb.texture_margin_left = margin
	sb.texture_margin_right = margin
	sb.texture_margin_top = margin
	sb.texture_margin_bottom = margin
	sb.axis_stretch_horizontal = StyleBoxTexture.AXIS_STRETCH_MODE_TILE_FIT
	sb.axis_stretch_vertical = StyleBoxTexture.AXIS_STRETCH_MODE_TILE_FIT
	sb.set_content_margin_all(content)
	return sb


static func panel() -> StyleBoxTexture:
	return _box("panel_leather", 14, 10)


static func parchment() -> StyleBoxTexture:
	return _box("panel_parchment", 8, 8)


static func titlebar() -> StyleBoxTexture:
	var sb := _box("titlebar", 7, 4)
	sb.content_margin_left = 12
	return sb


static func label(text: String, color := TEXT, size := FONT_SIZE, outline := true) -> Label:
	var l := Label.new()
	l.text = text
	l.add_theme_font_size_override("font_size", size)
	l.add_theme_color_override("font_color", color)
	if outline:
		l.add_theme_color_override("font_outline_color", Color(0.05, 0.03, 0.02))
		l.add_theme_constant_override("outline_size", 3)
	l.mouse_filter = Control.MOUSE_FILTER_IGNORE
	return l
